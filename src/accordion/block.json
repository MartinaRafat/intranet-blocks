{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "intranet/accordion",
	"version": "2.0.0",
	"title": "Document Accordion",
	"category": "intranet",
	"icon": "list-view",
	"description": "Collapsible sections for policies and documents, with search and expand all.",
	"keywords": [ "faq", "policies", "documents", "collapse" ],
	"textdomain": "intranet-blocks",
	"attributes": {
		"showSearch": { "type": "boolean", "default": true },
		"showToggleAll": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
