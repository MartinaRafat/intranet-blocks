{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "intranet/stats",
	"version": "2.1.0",
	"title": "Key Numbers",
	"category": "intranet",
	"icon": "chart-bar",
	"description": "A row of big numbers that count up when they come into view.",
	"keywords": [ "stats", "counter", "kpi", "numbers" ],
	"textdomain": "intranet-blocks",
	"attributes": {
		"columns": { "type": "number", "default": 4 }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
