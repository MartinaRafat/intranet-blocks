{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "intranet/carousel",
  "version": "2.0.0",
  "title": "Portal Carousel",
  "category": "intranet",
  "icon": "slides",
  "description": "Full-width slides for announcements, with arrows, dots, swipe and an accessible pause button.",
  "keywords": [
    "slider",
    "hero",
    "banner"
  ],
  "textdomain": "intranet-blocks",
  "attributes": {
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "interval": {
      "type": "number",
      "default": 6
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "height": {
      "type": "number",
      "default": 420
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}